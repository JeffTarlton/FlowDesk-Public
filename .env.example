# FlowDesk environment variables - full guide: docs/SETUP.md
# Local development: copy this file to .env.local and fill in the values.
# Vercel: add the same variables under Project Settings > Environment Variables, then redeploy.
# Everything here is embedded in the browser bundle, so never put a secret or service_role key in it.

# Supabase Project URL (Project Settings > Data API), e.g. https://abcdefghijklmnopqrst.supabase.co
VITE_SUPABASE_URL=

# Supabase public key (Project Settings > API Keys).
# Either the legacy "anon" key or the new publishable key (sb_publishable_...) works.
VITE_SUPABASE_ANON_KEY=

# Optional: FullCalendar Premium license key for the Calendar "Timeline" view.
# Leave empty to run without one (FullCalendar then shows a small license notice on that view only).
VITE_FULLCALENDAR_LICENSE_KEY=
